# Боевой конфиг для slovostat.ru. Файл общий на весь сервер, поэтому конфиги
# соседних инструментов лежат отдельными файлами в /etc/caddy/conf.d/ и
# подключаются импортом в конце — копирование этого файла их не затирает.
#
#   sudo mkdir -p /etc/caddy/conf.d
#   sudo cp /opt/slovostat/deploy/Caddyfile /etc/caddy/Caddyfile
#   # именно от caddy: под sudo валидация создаёт файлы логов от root,
#   # и потом сервис не может их открыть (permission denied при reload)
#   sudo -u caddy caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Сертификаты Caddy получает и продлевает сам — но только после того, как
# A-запись домена начнёт указывать на этот сервер.

(common) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

slovostat.ru {
	import common slovostat
	reverse_proxy 127.0.0.1:8000
}

www.slovostat.ru {
	redir https://slovostat.ru{uri} permanent
}

# Конфиги остальных инструментов сервера. Каждый кладёт свой файл, например
# /etc/caddy/conf.d/seo-report-ai.caddy:
#
# 	itogoskaz.ru {
# 		import common itogoskaz
# 		reverse_proxy 127.0.0.1:8001
# 	}
#
# Импорт стоит последним, чтобы сниппет (common) был уже определён к моменту
# разбора этих файлов.
import /etc/caddy/conf.d/*.caddy
