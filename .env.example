# Скопировать в .env рядом с docker-compose.yml и поправить под сервер.

# Порт на 127.0.0.1, куда смотрит reverse proxy. Для каждого инструмента свой.
SLOVOSTAT_PORT=8000

# Лимит запросов в день на IP.
SLOVOSTAT_RATE_LIMIT=25

# Максимальный размер страницы (МБ). На 2 ГБ RAM с несколькими сервисами
# разумно держать 3–5: разбор 5 МБ добавляет ~80 МБ к памяти процесса.
SLOVOSTAT_MAX_PAGE_MB=5

# Номер счётчика Яндекс.Метрики. Пусто — счётчик не подключается
# (локальный стенд, тесты, чужие копии).
SLOVOSTAT_METRIKA_ID=
